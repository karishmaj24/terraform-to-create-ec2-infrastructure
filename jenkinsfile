pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/karishmaj24/terraform-to-create-ec2-infrastructure.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build --no-cache -t karisheyy/myapp:latest .'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker push karisheyy/myapp:latest
                        docker logout
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f myapp 2>/dev/null || true
                    docker pull karisheyy/myapp:latest
                    docker run -d --name myapp -p 80:80 karisheyy/myapp:latest
                '''
            }
        }
    }
}
